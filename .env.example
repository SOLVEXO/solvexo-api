# Example environment — copy to `.env` and fill in real values. Only variables introduced by the POS
# hardening work are documented here; the full set of required secrets lives in your deployed `.env`.

# ── POS plan entitlement rollout ───────────────────────────────────────────────────────────────────
# Gate for PosEntitlementGuard (src/pos/guards/pos-entitlement.guard.ts), which requires an active POS
# plan on the SELLING routes: open a session, create/hold/complete a sale, browse POS products. PIN login,
# session close, cash adjustments, refunds, voids and reports are never gated.
#
#   false (default, or unset) = REPORT-ONLY. Nothing is blocked; the guard logs a WARN line per request it
#                               WOULD have blocked ("[report-only] would block POST /api/pos/sales —
#                               store=<id> reason=<no plan|plan expired|store suspended>"). Use this to find
#                               stores still selling without a plan before turning enforcement on.
#   true                      = ENFORCE. Blocked requests get 403 {code:'POS_PLAN_REQUIRED'|'POS_STORE_DISABLED'}.
#
# Only the exact string "true" enforces. Roll out: deploy with false → review the warnings and run
# `src/scripts/pos-plan-backfill.ts` (dry run, then --grant) → set to true and restart.
POS_ENTITLEMENT_ENFORCED=false

# ── POS legacy auth sunset (Phase 5D.1) ─────────────────────────────────────────────────────────────
# POS routes accept a registered DEVICE token (preferred) or, for installs that predate devices, the owner/staff JWT.
#   true (default) = legacy owner-JWT POS installs keep working; the app walks the owner through device setup on its own.
#   false          = owner/staff JWTs are refused on POS routes with 403 {code:'POS_LEGACY_AUTH_DISABLED'}; the app reacts by
#                    forcing "Set up this device" (cart and unsynced sales are kept). Flip it once all tills are registered.
# Note: this also applies to any web POS terminal that calls /api/pos with the owner session.
POS_LEGACY_AUTH_ALLOWED=true

# ── POS plan billing webhook (Phase 5E) ─────────────────────────────────────────────────────────────
# POST /api/pos-subscriptions/webhooks/stripe must be subscribed (in Stripe) to:
#   checkout.session.completed, checkout.session.async_payment_succeeded, charge.refunded, charge.dispute.created, charge.dispute.closed
# A FULL refund or a dispute takes the purchase unused days back (a WON dispute gives exactly those days back); partial refunds are ignored.
POS_PLANS_STRIPE_WEBHOOK_SECRET=

# ── Sign in with Apple (Phase 5F.1) ─────────────────────────────────────────────────────────────────
# Comma-separated accepted token audiences: the iOS app bundle id (native sign-in) AND the web Services ID (portal).
# e.g. APPLE_CLIENT_ID=com.solvexo.solvexoPos,com.solvexo.account.web
APPLE_CLIENT_ID=
# Account deletion must REVOKE the Sign in with Apple token at Apple (App Store 5.1.1(v)). To do that the backend exchanges the
# sign-in authorization code (client secret = ES256 JWT signed with your .p8 key) and stores Apple's refresh token ENCRYPTED.
# All five are optional: without them login still works and revocation is skipped (logged; retried hourly once configured).
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Contents of the AuthKey_XXXX.p8 (escape newlines as \n if your host needs a single line)
APPLE_PRIVATE_KEY=
# 32 random bytes, base64 — encrypts the stored Apple refresh tokens (AES-256-GCM). Generate: openssl rand -base64 32
APPLE_TOKEN_ENC_KEY=

# ── Solvexo Account web portal (Phase 5G) ───────────────────────────────────────────────────────────
# Exact origins allowed by CORS for the portal, comma-separated. https only (http allowed for localhost). No wildcards.
# e.g. PORTAL_ORIGINS=https://account.solvexo.store,https://solvexo-account.vercel.app
PORTAL_ORIGINS=

# ── Portal cookie session (Phase 5G.1) ──────────────────────────────────────────────────────────────
# The portal (not the mobile apps) opts in with `X-Auth-Mode: cookie`: the refresh token then lives ONLY in an HttpOnly,
# Secure, SameSite=Lax cookie `solvexo_rt` (Path=/api/auth/refresh), rotated on every refresh with reuse detection.
# SameSite=Lax cookies are only sent when portal and API share a registrable domain (account.<domain> + api.<domain>).
# Set the cookie Domain to the shared parent (leading dot) so BOTH hosts see it; leave empty only for same-host/local dev.
# e.g. AUTH_COOKIE_DOMAIN=.solvexo.store
AUTH_COOKIE_DOMAIN=
# HMAC key for the double-submit CSRF cookie. Falls back to a key derived from JWT_SECRET (distinct label) when empty.
CSRF_SECRET=
