{
  "name": "searchOrders",
  "label": "Search Orders",
  "description": "Lists your store's orders, newest first. Filter by status, paid, or changed since a date.",
  "type": "search",
  "communication": {
    "url": "/orders",
    "method": "GET",
    "qs": {
      "limit": 100,
      "status": "{{parameters.status}}",
      "paid": "{{parameters.paid}}",
      "updated_since": "{{formatDate(parameters.updatedSince; 'YYYY-MM-DDTHH:mm:ss[Z]'; 'UTC')}}"
    },
    "response": {
      "limit": "{{parameters.limit}}",
      "iterate": "{{body.items}}",
      "output": "{{item}}"
    },
    "pagination": {
      "qs": { "cursor": "{{body.next_cursor}}" },
      "condition": "{{body.has_more}}"
    }
  },
  "mappableParameters": [
    { "name": "status", "label": "Status", "type": "select", "options": [
      { "label": "Pending", "value": "pending" }, { "label": "Processing", "value": "processing" }, { "label": "Shipped", "value": "shipped" },
      { "label": "Delivered", "value": "delivered" }, { "label": "Completed", "value": "completed" }, { "label": "Cancelled", "value": "cancelled" }, { "label": "Refunded", "value": "refunded" }
    ] },
    { "name": "paid", "label": "Paid", "type": "select", "options": [{ "label": "Paid only", "value": "true" }, { "label": "Unpaid only", "value": "false" }] },
    { "name": "updatedSince", "label": "Changed since", "type": "date" },
    { "name": "limit", "label": "Maximum number of results", "type": "uinteger", "default": 10, "required": true }
  ],
  "interface": [
    { "name": "id", "label": "Order ID", "type": "text" },
    { "name": "order_number", "label": "Order number", "type": "text" },
    { "name": "created_at", "label": "Created at", "type": "date" },
    { "name": "currency", "label": "Currency", "type": "text" },
    { "name": "status", "label": "Status", "type": "text" },
    { "name": "paid", "label": "Paid", "type": "boolean" },
    { "name": "payment_method", "label": "Payment method", "type": "text" },
    { "name": "customer_id", "label": "Customer ID", "type": "text" },
    { "name": "shipping_address", "label": "Shipping address", "type": "collection", "spec": [
      { "name": "name", "label": "Name", "type": "text" }, { "name": "phone", "label": "Phone", "type": "text" },
      { "name": "address1", "label": "Address 1", "type": "text" }, { "name": "address2", "label": "Address 2", "type": "text" },
      { "name": "city", "label": "City", "type": "text" }, { "name": "province", "label": "Province", "type": "text" },
      { "name": "zip", "label": "Postcode", "type": "text" }, { "name": "country", "label": "Country", "type": "text" }
    ] },
    { "name": "line_items", "label": "Line items", "type": "array", "spec": { "type": "collection", "spec": [
      { "name": "id", "label": "Line ID", "type": "text" }, { "name": "name", "label": "Name", "type": "text" },
      { "name": "sku", "label": "SKU", "type": "text" }, { "name": "variant_id", "label": "Variant ID", "type": "text" },
      { "name": "quantity", "label": "Quantity", "type": "number" }, { "name": "price", "label": "Price", "type": "number" },
      { "name": "total", "label": "Line total", "type": "number" }
    ] } },
    { "name": "subtotal", "label": "Subtotal", "type": "number" },
    { "name": "shipping", "label": "Shipping", "type": "number" },
    { "name": "total", "label": "Total", "type": "number" },
    { "name": "refunded_total", "label": "Refunded", "type": "number" },
    { "name": "shipped_at", "label": "Shipped at", "type": "date" },
    { "name": "cancelled_at", "label": "Cancelled at", "type": "date" }
  ]
}
