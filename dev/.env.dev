# DEV ONLY — obviously fake secrets, safe to commit. Loaded by dev/up.sh and docker-compose.dev.yml.
# The real .env is never read by the dev stack.
NODE_ENV=development
PORT=3102
JWT_SECRET=dev-only-jwt-secret-not-for-production
CSRF_SECRET=dev-only-csrf-secret-not-for-production
APPLE_TOKEN_ENC_KEY=ZGV2LW9ubHktMzItYnl0ZS1rZXktZm9yLXRlc3RzISE=
# Database / cache (up.sh overrides host ports; compose uses the service names via its own environment block)
MONGO_URI=mongodb://127.0.0.1:27118/solvexo_dev?replicaSet=rsdev
REDIS_URL=redis://127.0.0.1:6479
# Test hooks (each is ignored when NODE_ENV=production)
DEV_OTP_LOG=true
DEV_DISABLE_THROTTLE=true
# POS rollout switches — enforced so plan expiry / restricted mode can be tested; legacy owner JWT auth still allowed
POS_ENTITLEMENT_ENFORCED=true
POS_LEGACY_AUTH_ALLOWED=true
# G3.3: store credit runs on the new minor-unit ledger in the dev stack (production switches with its own, approved change set)
STORE_CREDIT_LEDGER=new
# Browser origins allowed by CORS (portal dev server + Playwright preview), no wildcards
PORTAL_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173
# Social login: left blank locally (Google/Apple tokens cannot be verified offline)
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=com.solvexo.solvexoPos
# Billing: the no-op "manual" provider (dev/CI only; refuses to start in production). Stripe keys BLANK on purpose — never put live or test keys here
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_TEST=
# SMTP unused (mail goes to the dev log sink)
SMTP_HOST=localhost
SMTP_PORT=2525
SMTP_USER=dev
SMTP_PASSWORD=dev
SMTP_FROM=dev@solvexo.local
APP_NAME=SolvexoDev
PAYMENT_PROVIDER=manual

# G2: business verification (KYB) encryption key + Raast QR payments on the MOCK provider (dev/CI only; the mock is never registered in production)
KYB_ENC_KEY_V1=ZGV2LW9ubHkta3liLWtleS0zMi1ieXRlcy1mYWtlISE=
KYB_ENC_KEY_CURRENT=1
PAYMENTS_PROVIDER_POS=mock
PAYMENTS_MOCK_CONTROL=true
# QR lifetime: 3 minutes normally; the e2e runs start the stack with E2E_QR_TTL=10 so expiry can be tested in seconds
PAYMENTS_QR_TTL_SECONDS=${E2E_QR_TTL:-180}
PAYMENTS_TICK_MS=1000
# dev: a confirmed payment that no sale used shows up in Needs attention after 5 s (production: 2 minutes)
PAYMENTS_UNATTACHED_GRACE_SECONDS=5

# G5.7 real-backend flows: uploads are not sent anywhere (no storage credentials in the dev stack) — see UploadService (ignored in production)
DEV_UPLOAD_STUB=true
# G5.2.0b: the customer-facing receipt origin differs from the API's here, so the flows prove the receipt QR comes from RECEIPT_PUBLIC_URL (the
# simulator reaches the host on 127.0.0.1 as well as localhost)
RECEIPT_PUBLIC_URL=http://127.0.0.1:3102
