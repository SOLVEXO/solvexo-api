# DEV ONLY — obviously fake secrets, safe to commit. Loaded by dev/up.sh and docker-compose.dev.yml.
# The real .env is never read by the dev stack.
NODE_ENV=development
PORT=3102
JWT_SECRET=dev-only-jwt-secret-not-for-production
CSRF_SECRET=dev-only-csrf-secret-not-for-production
APPLE_TOKEN_ENC_KEY=ZGV2LW9ubHktMzItYnl0ZS1rZXktZm9yLXRlc3RzISE=
# Database / cache (up.sh overrides host ports; compose uses the service names via its own environment block)
MONGO_URI=mongodb://127.0.0.1:27118/solvexo_dev?replicaSet=rsdev
REDIS_URL=redis://127.0.0.1:6479
# Test hooks (each is ignored when NODE_ENV=production)
DEV_OTP_LOG=true
DEV_DISABLE_THROTTLE=true
# POS rollout switches — enforced so plan expiry / restricted mode can be tested; legacy owner JWT auth still allowed
POS_ENTITLEMENT_ENFORCED=true
POS_LEGACY_AUTH_ALLOWED=true
# Browser origins allowed by CORS (portal dev server + Playwright preview), no wildcards
PORTAL_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173
# Social login: left blank locally (Google/Apple tokens cannot be verified offline)
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=com.solvexo.solvexoPos
# Billing: the no-op "manual" provider (dev/CI only; refuses to start in production). Stripe keys BLANK on purpose — never put live or test keys here
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_TEST=
# SMTP unused (mail goes to the dev log sink)
SMTP_HOST=localhost
SMTP_PORT=2525
SMTP_USER=dev
SMTP_PASSWORD=dev
SMTP_FROM=dev@solvexo.local
APP_NAME=SolvexoDev
PAYMENT_PROVIDER=manual
