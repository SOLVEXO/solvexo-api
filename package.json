{
  "name": "ecommerce-nest-backend",
  "version": "1.0.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build && tsc-alias",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "npm run build && node dist/main",
    "start:dev": "cross-env CHOKIDAR_USEPOLLING=1 concurrently -k -n nest,alias -c blue,yellow \"nest start --watch\" \"tsc-alias -w\"",
    "start:debug": "cross-env CHOKIDAR_USEPOLLING=1 concurrently -k -n nest,alias -c blue,yellow \"nest start --debug --watch\" \"tsc-alias -w\"",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:full": "jest --maxWorkers=2",
    "test:di": "MONGO_URI=${DI_SMOKE_MONGO_URI:-mongodb://127.0.0.1:27017/solvexo_di_smoke} NODE_OPTIONS=--max-old-space-size=6144 jest src/pos/pos.module-di.smoke.spec.ts --runInBand --forceExit",
    "test:handles": "jest --runInBand --detectOpenHandles",
    "dev:stack:up": "bash dev/up.sh",
    "dev:stack:down": "bash dev/down.sh",
    "dev:seed": "ts-node --transpile-only dev/seed.ts",
    "kyb:rotate-key": "ts-node -r tsconfig-paths/register src/scripts/kyb-rotate-key.ts",
    "dev:expire-plan": "ts-node --transpile-only dev/seed.ts --expire-plan",
    "dev:restore-plan": "ts-node --transpile-only dev/seed.ts --restore-plan"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.10",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.2.10",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.10",
    "@nestjs/platform-socket.io": "^11.2.10",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.2.5",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^11.2.10",
    "apple-signin-auth": "^2.1.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.81.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^1.41.3",
    "cookie-parser": "^1.4.7",
    "firebase-admin": "^13.6.1",
    "geoip-lite": "^1.4.10",
    "google-auth-library": "^10.9.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "liquidjs": "^10.30.1",
    "mongodb": "~7.9.0",
    "mongoose": "^9.12.1",
    "multer": "^2.0.2",
    "multer-storage-cloudinary": "^4.0.0",
    "nestjs-i18n": "^10.8.5",
    "nodemailer": "^8.0.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pdf-lib": "^1.17.1",
    "redis": "^5.12.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.4",
    "streamifier": "^0.1.1",
    "stripe": "^22.6.2",
    "ua-parser-js": "^2.0.10",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.2.10",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/geoip-lite": "^1.4.4",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^7.0.10",
    "@types/streamifier": "^0.1.2",
    "@types/supertest": "^7.2.1",
    "@types/yauzl": "^3.4.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "modulePaths": [
      "<rootDir>/.."
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/../test/jest-mongodb-runtime.ts"
    ],
    "maxWorkers": 2,
    "workerIdleMemoryLimit": "1GB",
    "globalSetup": "<rootDir>/../test/jest-global-setup.ts",
    "globalTeardown": "<rootDir>/../test/jest-global-teardown.ts"
  }
}
